<!DOCTYPE html>
<html lang="en">
<%- include('includes/head.ejs', { pageTitle: pageTitle }) %>
<body>
    <header>Header</header>
    <form method="post">
        <div>
            <h1>Player Register</h1>
            <hr>
        </div>
        <div>
            <div class="credentials">
                <label for="fullname" class="credentials-label">Player Name:</label>
                <input type="text" name="fullname" id="fullname" class="credentials-input">
                <label for="input" class="credentials-label">Age:</label>
                <input type="number" name="age" id="age" class="credentials-input">
                <label for="username" class="credentials-label">Username:</label>
                <div class="username">
                    <input type="text" name="username" id="username" class="credentials-input">
                    <i class="fa-solid fa-dice-five icon"></i>
                </div>
                <label for="password" class="credentials-label">Password:</label>
                <div>
                    <input type="password"name="password" id="password" class="credentials-input password" >
                    <i class="fa-solid fa-eye toggle-password"></i>
                </div>
            </div>
            <div class="sign-in-actions">    
                <button type="submit" class="success-sign-in">REGISTER</button>
                <button type="button" class="cancel-sign-in" onclick="history.back()">CANCEL</button>
            </div>
        </div>
        <p>*By registering, you agree to our Terms and Conditions</p>
    </form>
    
    <%-include('includes/footer.ejs')%>
</body>
</html>