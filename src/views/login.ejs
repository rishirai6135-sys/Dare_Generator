<!DOCTYPE html>
<html lang="en">
<%- include('includes/head.ejs', { pageTitle: pageTitle }) %>
<body>
    <header>Header</header>
    <form method="post">
        <div>
            <h1>Welcome Back</h1>
            <hr>
        </div>
        <div>
            <div class="credentials">
                <label for="register-username" class="credentials-label">Username:</label>
                <input type="text" name="password" id="register-username" class="credentials-input">
                <label for="register-password" class="credentials-label">Password:</label>
                <input type="password" name="username" id="register-password" class="credentials-input">
            </div>
            <div class="sign-in-actions">    
                <button type="submit" class="success-sign-in login">LOG IN</button>
                <button type="button" class="cancel-sign-in redirect-register"><a href="/register">CREATE ACCOUNT</a></button>
            </div>
        </div>
        <p>*By logining, you agree to our Terms and Conditions</p>
    </form>
    
    <%-include('includes/footer.ejs')%>
</body>
</html>