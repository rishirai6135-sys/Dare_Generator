<!DOCTYPE html>
<html lang="en">
<%- include('includes/head.ejs', { pageTitle: pageTitle }) %>
<body>
    <header>Header</header>
    <form method="post">
        <div>
            <h1>Player Register</h1>
            <hr>
        </div>
        <div>
            <div class="credentials">
                <label for="register-fullname" class="credentials-label">Player Name:</label>
                <input type="text" name="fullname" id="register-fullname" class="credentials-input">
                <label for="register-input" class="credentials-label">Age:</label>
                <input type="number" name="age" id="register-age" class="credentials-input">
                <label for="register-username" class="credentials-label">Username:</label>
                <input type="text" name="password" id="register-username" class="credentials-input">
                <label for="register-password" class="credentials-label">Password:</label>
                <input type="password" name="username" id="register-password" class="credentials-input">
            </div>
            <div class="sign-in-actions">    
                <button type="button" class="success-sign-in">REGISTER</button>
                <button type="submit" class="cancel-sign-in" onclick="">CANCEL</button>
            </div>
        </div>
        <p>*By registering, you agree to our Terms and Conditions</p>
    </form>
    
    <%-include('includes/footer.ejs')%>
</body>
</html>